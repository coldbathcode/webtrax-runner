{
  "name": "@webtrax/cli",
  "version": "0.1.1",
  "description": "Check a website for broken links, redirects, security headers, SEO basics, accessibility and performance, from your terminal, your CI or your coding agent (MCP).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "webtrax": "dist/webtrax.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "website",
    "broken-links",
    "link-checker",
    "seo",
    "accessibility",
    "security-headers",
    "performance",
    "mcp",
    "ci",
    "webtrax"
  ],
  "homepage": "https://docs.webtrax.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldbathcode/webtrax-runner.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/coldbathcode/webtrax-runner/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axe-core": "4.14.0",
    "cheerio": "^1.2.0",
    "playwright-core": "1.57.0",
    "robots-parser": "^3.0.1",
    "undici": "^8.12.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@webtrax/engine": "workspace:*",
    "@webtrax/net-guard": "workspace:*",
    "@webtrax/protocol": "workspace:*",
    "@webtrax/reporters": "workspace:*",
    "@webtrax/suite-a11y": "workspace:*",
    "@webtrax/suite-links": "workspace:*",
    "@webtrax/suite-performance": "workspace:*",
    "@webtrax/suite-security": "workspace:*",
    "@webtrax/suite-seo": "workspace:*",
    "esbuild": "0.27.7",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
