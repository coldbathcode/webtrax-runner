{
  "name": "@webtrax/reporters",
  "version": "0.0.0",
  "private": true,
  "description": "Reports for Webtrax runs: console summary, JSON and NDJSON, Markdown (for pull requests and for pasting into an LLM) and a single-file, offline, accessible HTML report.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@webtrax/protocol": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "playwright": "1.57.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
