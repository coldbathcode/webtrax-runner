{
  "name": "@webtrax/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "The Webtrax runner protocol: Zod schemas and JSON Schema for job specs, findings, metrics, pages, snapshots, artifacts and run summaries, plus fingerprints and the WebtraxBot identity.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bot": "./src/bot.ts",
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:schema": "UPDATE_SCHEMA=1 vitest run test/json-schema.test.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "@types/node": "^22.20.5"
  }
}
